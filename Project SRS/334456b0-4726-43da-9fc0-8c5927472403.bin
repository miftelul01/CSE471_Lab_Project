# Neon PostgreSQL — pooled connection, used by the app at runtime.
# pgbouncer=true tells Prisma not to use prepared statements, which a
# transaction pooler cannot hold across queries.
DATABASE_URL="postgresql://neondb_owner:npg_CR4nJ1vVXQka@ep-royal-flower-az5qvy90-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct (unpooled) connection — same host without "-pooler".
# Prisma Migrate needs this: a pooler can't run its DDL or hold advisory locks.
DIRECT_URL="postgresql://neondb_owner:npg_CR4nJ1vVXQka@ep-royal-flower-az5qvy90.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

