# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Where to find these:
#   Supabase dashboard -> your project -> Project Settings -> API

# --- Supabase (required) ---
# Safe to expose to the browser. RLS policies are what protect your data.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# SECRET. Bypasses Row Level Security. Server-side only — never import
# lib/supabase/admin.ts from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Used to build the OAuth redirect URL. Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Schema tooling (only needed if you change the database) ---

# Used by `npm run db:push`. Copy it from the Supabase dashboard:
# Connect -> Session pooler. Port 5432 is session mode, which migrations
# require; port 6543 is transaction mode and cannot run DDL.
SUPABASE_DB_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# Used by `npm run db:types`. PER-PERSON — a personal access token grants
# access to every project in your Supabase account, so never share or commit
# it. Create one at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN="sbp_..."

# --- Module 3 integrations (leave blank until you get to that feature) ---
# Mahia — Google Maps API (M3.3)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Mahia (M3.4 Google Tasks) + Araf (M3.6 Google Calendar).
# Same OAuth client as the Google SSO login; just add the extra scopes.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Miftelul — Payments (M3.2). Use test keys only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
